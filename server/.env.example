APP_NAME=Excellent App Backend
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
SECRET_KEY=change-me-in-production-use-strong-key
JWT_EXPIRE_MINUTES=1440
ACCESS_TOKEN_EXPIRE_MINUTES=1440

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DB=excellent_app
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=20

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
LOG_LEVEL=INFO

TENCENT_COS_ENABLED=false
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_REGION=ap-nanjing
TENCENT_COS_BUCKET=
TENCENT_COS_ENDPOINT=
TENCENT_COS_PUBLIC_BASE_URL=
TENCENT_COS_PRODUCT_PREFIX=products
TENCENT_COS_MAX_UPLOAD_SIZE=5242880

# 阿里云短信配置
# 申请地址: https://dysms.console.aliyun.com/
SMS_ENABLED=true
SMS_ALIYUN_ACCESS_KEY_ID=your_access_key_id
SMS_ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret
SMS_SIGN_NAME=西安卓越恒升
SMS_TEMPLATE_CODE=SMS_508180185
SMS_TEMPLATE_PARAM_NAME=number

# 阿里云一键登录配置（可选）
DYNPNS_ENABLED=false
DYNPNS_ACCESS_KEY_ID=
DYNPNS_ACCESS_KEY_SECRET=
DYNPNS_SIGNATURE_SECRET=
DYNPNS_APP_KEY=

PAYMENT_MOCK_EXTERNAL_PAYMENT=true
PAYMENT_DEFAULT_CURRENCY=CNY
PAYMENT_REQUEST_TIMEOUT_SECONDS=15

# 微信支付配置（开发阶段保持 WECHAT_PAY_ENABLED=false，以下敏感参数留空）。
# 生产部署时，将这些变量放入 PAYMENT_ENV_FILE 指向的运行时 env 文件；
# 私钥和平台证书只通过 PAYMENT_SECRETS_DIR 以只读方式挂载，不要写入仓库。
WECHAT_PAY_ENABLED=false
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCHID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_MERCHANT_SERIAL_NO=
WECHAT_PAY_MERCHANT_PRIVATE_KEY_PATH=
WECHAT_PAY_PLATFORM_CERT_PATH=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_REFUND_NOTIFY_URL=
# H5 MWEB 场景通常使用 WAP；原生 App/JSAPI 请按对应客户端流程配置。
WECHAT_PAY_H5_TYPE=WAP
# 兼容旧变量名；新配置优先使用 WECHAT_PAY_H5_TYPE。
WECHAT_PAY_H5_INFO_TYPE=
WECHAT_PAY_H5_RETURN_URL=
# 兼容旧变量名；新配置优先使用 WECHAT_PAY_H5_RETURN_URL。
WECHAT_PAY_H5_REDIRECT_URL=
WECHAT_PAY_APP_SUBJECT_PREFIX=Excellent

ALIPAY_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_APP_CERT_PATH=
ALIPAY_PUBLIC_CERT_PATH=
ALIPAY_ROOT_CERT_PATH=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
ALIPAY_PAYMENT_METHOD=alipay.trade.wap.pay
ALIPAY_CHARSET=utf-8
ALIPAY_SIGN_TYPE=RSA2
ALIPAY_SANDBOX_ALLOW_UNVERIFIED_QUERY_RESPONSE=false
ALIPAY_SELLER_ID=
ALIPAY_APP_SUBJECT_PREFIX=Excellent
