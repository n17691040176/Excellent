# ===========================================
# 生产环境配置文件
# ===========================================
# 使用方法: cp .env.prod .env 然后编辑 .env 填入真实密钥

# 应用程序
APP_ENV=production
APP_DEBUG=false

# 安全密钥 - 必须修改！
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=YOUR_SECRET_KEY_HERE

# MySQL
MYSQL_ROOT_PASSWORD=YOUR_STRONG_ROOT_PASSWORD
MYSQL_DATABASE=excellent_app
MYSQL_USER=excellent
MYSQL_PASSWORD=YOUR_STRONG_DB_PASSWORD
MYSQL_PORT=3306

# Redis
REDIS_PASSWORD=
REDIS_PORT=6379

# 支付运行时配置文件。建议把支付宝和微信变量放在同一个文件中，
# 由 docker-compose.prod.yml 的 PAYMENT_ENV_FILE 注入后端容器。
# 留空时兼容旧变量 ALIPAY_ENV_FILE 及默认路径。
PAYMENT_ENV_FILE=
ALIPAY_ENV_FILE=/www/wwwroot/excellent/server/.env.alipay.local

# 支付私钥/证书所在宿主机目录（容器内只读挂载为 /run/secrets）。
PAYMENT_SECRETS_DIR=/www/wwwroot/excellent/secrets

# 端口配置
PUBLIC_API_BASE_URL=https://175.27.228.166
