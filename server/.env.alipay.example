# Excellent - Alipay H5/WAP sandbox payment configuration
#
# Copy this file to server/.env.alipay.local and fill in the sandbox values.
# The .local file is ignored by Git. Never commit merchant private keys,
# Alipay public keys, APP secrets, or production URLs containing credentials.
#
# This project is embedded as H5 inside another App, so use WAP payment.

# -----------------------------------------------------------------------------
# Environment and payment safety
# -----------------------------------------------------------------------------
APP_ENV=production
PAYMENT_MOCK_EXTERNAL_PAYMENT=false
PAYMENT_DEFAULT_CURRENCY=CNY
PAYMENT_REQUEST_TIMEOUT_SECONDS=15

# -----------------------------------------------------------------------------
# Alipay application credentials
# -----------------------------------------------------------------------------
ALIPAY_ENABLED=true

# Alipay sandbox application APP-ID
ALIPAY_APP_ID=请填写支付宝沙箱APP_ID

# Files on the backend host/container. Do not paste key contents here.
# The default Docker paths match docker-compose.prod.yml.
ALIPAY_PRIVATE_KEY_PATH=/run/secrets/alipay-merchant-private-key.pem

# Certificate signing mode is the only supported Alipay integration mode.
# Download all three certificates from Alipay and place them in PAYMENT_SECRETS_DIR.
ALIPAY_APP_CERT_PATH=/run/secrets/alipay-app-cert.crt
ALIPAY_PUBLIC_CERT_PATH=/run/secrets/alipay-public-cert.crt
ALIPAY_ROOT_CERT_PATH=/run/secrets/alipay-root-cert.crt

# Optional: fill this when the Alipay callback contains a fixed seller_id.
ALIPAY_SELLER_ID=

# -----------------------------------------------------------------------------
# Callback and gateway URLs
# -----------------------------------------------------------------------------
# Must be a public HTTPS endpoint. The backend route is fixed by the project.
ALIPAY_NOTIFY_URL=https://请填写你的公网域名/api/v1/payments/alipay/notify

# H5 page to return to after Alipay finishes. This is for display/navigation
# only; the order status must still be loaded from the backend after return.
# uni-app H5 uses hash routing in this project.
ALIPAY_RETURN_URL=https://请填写你的H5域名/#/subpackages/order/detail

# Sandbox gateway:
ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# Production gateway:
# ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do

ALIPAY_PAYMENT_METHOD=alipay.trade.wap.pay
ALIPAY_CHARSET=utf-8
ALIPAY_SIGN_TYPE=RSA2
ALIPAY_APP_SUBJECT_PREFIX=Excellent

# -----------------------------------------------------------------------------
# Docker-only secret mount
# -----------------------------------------------------------------------------
# Host directory containing:
#   alipay-merchant-private-key.pem
#   alipay-app-cert.crt
#   alipay-public-cert.crt
#   alipay-root-cert.crt
# docker-compose.prod.yml mounts this directory to /run/secrets:ro.
PAYMENT_SECRETS_DIR=/www/wwwroot/excellent/secrets

# -----------------------------------------------------------------------------
# H5 build/API settings
# -----------------------------------------------------------------------------
# Leave empty when H5 and API are served from the same domain through Nginx.
# Otherwise set the public HTTPS API origin, for example:
# VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=

# -----------------------------------------------------------------------------
# Host App WebView checklist (not backend environment variables)
# -----------------------------------------------------------------------------
# 1. Allow navigation to https://openapi.alipay.com (or the sandbox gateway).
# 2. Allow the HTTPS notify/return domains used above.
# 3. If the WebView blocks external navigation, the host App must intercept
#    the Alipay gateway URL and open it through its browser/native bridge.
# 4. Do not pass raw merchant private keys through the WebView or frontend.
